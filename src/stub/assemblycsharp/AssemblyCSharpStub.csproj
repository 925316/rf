<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Generates the compile-time Assembly-CSharp stub. Part of rf.sln; the mod
    references it (and every other stub) via ProjectReference, so a plain build
    of rf.sln generates all reference assemblies automatically. Nothing is
    committed as binary; see the stub sources for the verified API surface.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Assembly-CSharp</AssemblyName>
    <RootNamespace>AssemblyCSharpStub</RootNamespace>
    <PlatformTarget>x86</PlatformTarget>
    <!-- Must match the real game assembly identity exactly: Version=0.0.0.0, unsigned. -->
    <Version>0.0.0.0</Version>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\unity.core\UnityCoreStub.csproj" />
  </ItemGroup>

</Project>
